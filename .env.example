# floci-api config (packages/api)

# ── Console auth ──────────────────────────────────────────────────────────────
# This server drives real cloud SDKs and exposes destructive operations, so
# /api/* is deny-by-default. Leave FLOCI_UI_TOKEN unset and the API generates a
# token per boot and prints a one-click URL that sets the session cookie. Set it
# to a fixed value for headless or scripted setups.
FLOCI_UI_TOKEN=
# Set to "off" to disable the gate entirely. Only for throwaway sandboxes.
FLOCI_UI_AUTH=
# Browser origins allowed to call the API cross-origin (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:4500

# ── Runtime endpoint ──────────────────────────────────────────────────────────
FLOCI_ENDPOINT=http://localhost:4566

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
PORT=4501
